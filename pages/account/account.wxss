/* 引入Tailwind类似样式 */
.container {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background-color: #f8f8f8;
  }
  
  /* 固定定位样式 */
  .fixed {
    position: fixed;
  }
  
  /* 颜色定义 */
  .bg-white {
    background-color: #ffffff;
  }
  .bg-gray-100 {
    background-color: #f3f4f6;
  }
  .bg-primary {
    background-color: #F47564;
  }
  .text-primary {
    color: #F47564;
  }
  .text-gray-500 {
    color: #6b7280;
  }
  .text-gray-600 {
    color: #4b5563;
  }
  .text-gray-700 {
    color: #374151;
  }
  .text-gray-400 {
    color: #9ca3af;
  }
  .text-white {
    color: #ffffff;
  }
  .text-black {
    color: #000000;
  }
  .text-yellow-400 {
    color: #facc15;
  }
  .text-green-500 {
    color: #22c55e;
  }
  .text-orange-400 {
    color: #fb923c;
  }
  .text-blue-400 {
    color: #60a5fa;
  }
  
  /* 布局样式 */
  .flex {
    display: flex;
  }
  .items-center {
    align-items: center;
  }
  .justify-between {
    justify-content: space-between;
  }
  .justify-center {
    justify-content: center;
  }
  .flex-col {
    flex-direction: column;
  }
  .w-full {
    width: 100%;
  }
  .w-14 {
    width: 56px;
  }
  .h-14 {
    height: 56px;
  }
  .w-6 {
    width: 24px;
  }
  .h-6 {
    height: 24px;
  }
  .w-4 {
    width: 16px;
  }
  .h-4 {
    height: 16px;
  }
  .px-4 {
    padding-left: 16px;
    padding-right: 16px;
  }
  .py-3 {
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .p-2 {
    padding: 8px;
  }
  /* 修改了不支持的 space-y 选择器 */
  .space-y-1 {
    margin-top: 4px;
  }
  .mr-2 {
    margin-right: 8px;
  }
  .ml-4 {
    margin-left: 16px;
  }
  .mt-4 {
    margin-top: 16px;
  }
  .mb-1 {
    margin-bottom: 4px;
  }
  .rounded-full {
    border-radius: 9999px;
  }
  .rounded-button {
    border-radius: 8px;
  }
  .border-b {
    border-bottom-width: 1px;
    border-bottom-style: solid;
  }
  .border-t {
    border-top-width: 1px;
    border-top-style: solid;
  }
  .border-gray-100 {
    border-color: #f3f4f6;
  }
  .text-sm {
    font-size: 14px;
  }
  .text-xs {
    font-size: 12px;
  }
  .text-base {
    font-size: 16px;
  }
  .text-3xl {
    font-size: 30px;
  }
  .text-4xl {
    font-size: 36px;
  }
  .font-medium {
    font-weight: 500;
  }
  .font-light {
    font-weight: 300;
  }
  .z-10 {
    z-index: 10;
  }
  .grid {
    display: grid;
  }
  .grid-cols-5 {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .gap-2 {
    gap: 8px;
  }
  .pt-16 {
    padding-top: 64px;
  }
  .pb-32 {
    padding-bottom: 128px;
  }
  .px-2 {
    padding-left: 8px;
    padding-right: 8px;
  }
  .py-2 {
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .p-4 {
    padding: 16px;
  }
  .px-6 {
    padding-left: 24px;
    padding-right: 24px;
  }
  
  /* 图标样式 */
  .ri-lg {
    font-size: 24px;
  }
  .ri-xs {
    font-size: 12px;
  }
  
  /* 输入框样式 */
  input {
    border: none;
    outline: none;
  }