.container {
    width: 100%;
    min-height: 100vh;
    background-color: #F8F9FA;
    position: relative;
  }
  
  /* 导航栏样式 */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    padding: 0 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #FFFFFF;
    border-bottom: 1px solid #F0F0F0;
    z-index: 100;
  }
  
  .navbar-title {
    font-size: 20px;
    font-weight: bold;
  }
  
  .navbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  
  .filter-btn {
    font-size: 16px;
    color: #007AFF;
  }
  
  .user-avatar {
    width: 40px;
    height: 40px;
    background-color: #007AFF;
    border-radius: 20px;
  }
  
  /* 主内容区域 */
  .content {
    padding-top: 44px;
    padding-bottom: 60px;
  }
  
  /* 时间筛选 */
  .time-filter {
    margin: 16px;
    background-color: #F0F0F0;
    border-radius: 12px;
    display: flex;
    overflow: hidden;
  }
  
  .filter-item {
    flex: 1;
    padding: 12px 0;
    text-align: center;
    font-size: 14px;
    color: #666666;
    background-color: transparent;
  }
  
  .filter-item.active {
    background-color: #FFFFFF;
    color: #000000;
    font-weight: 500;
  }
  
  /* 日期选择器 */
  .date-picker {
    margin: 24px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .arrow-btn {
    width: 40px;
    height: 40px;
    background-color: #007AFF;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
  }
  
  .month-text {
    font-size: 18px;
    font-weight: 500;
  }
  
  /* 卡片样式 */
  .card {
    margin: 16px;
    padding: 16px;
    background-color: #FFFFFF;
    border-radius: 12px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  
  .card-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .card-icon {
    width: 32px;
    height: 32px;
    background-color: #FFD60A;
    border-radius: 8px;
  }
  
  .title-text {
    font-size: 18px;
    font-weight: 500;
  }
  
  .arrow-icon {
    font-size: 16px;
    color: #999;
  }
  
  /* 卡片网格布局 */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  
  .grid-item {
    padding: 12px;
    background-color: #FAFAFA;
    border-radius: 8px;
  }
  
  .item-header {
    display: flex;
    align-items: center;
    margin-bottom: 8px;
  }
  
  .item-title {
    font-size: 14px;
    color: #666666;
  }
  
  .item-arrow {
    font-size: 14px;
    color: #999;
    margin-left: 4px;
  }
  
  .item-value {
    font-size: 20px;
    font-weight: bold;
  }
  
  /* 图表区域 */
  .average-text {
    font-size: 12px;
    color: #666666;
  }
  
  .chart-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 8px;
  }
  
  .date-text {
    font-size: 12px;
    color: #666666;
  }
  
  .footer-arrow {
    font-size: 14px;
    color: #999;
    margin-left: 4px;
  }
  
  /* 简单柱状图 */
  .simple-chart {
    width: 100%;
    height: 150px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 20px;
  }
  
  .chart-bar {
    flex: 1;
    margin: 0 1px;
    border-radius: 2px 2px 0 0;
  }
  
  
  
  .tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .tab-icon {
    width: 24px;
    height: 24px;
    background-color: #ddd;
    border-radius: 50%;
  }
  
  .tab-text {
    font-size: 12px;
    color: #666666;
    margin-top: 4px;
  }
  
  .tab-item.active .tab-text {
    color: #007AFF;
  }
  
  .active-text {
    color: #007AFF;
  }